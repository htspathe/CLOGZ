<section class="clogz-section clogz-color-motion" id="collections-{{ section.id }}" data-clogz-colors data-parallax="{{ section.settings.enable_parallax }}" style="--clogz-zoom:{{ section.settings.zoom_percent | divided_by: 100.0 }};--clogz-speed:{{ section.settings.zoom_speed }}s"><div class="clogz-container"><div class="clogz-headrow"><div><p class="clogz-eyebrow" style="color:var(--green)">COLLECTION CLOGZ</p><h2 class="clogz-heading">{% if section.settings.heading == 'Une couleur. Une attitude.' %}Une couleur. Une <span class="clogz-heading-accent">attitude.</span>{% else %}{{ section.settings.heading | escape }}{% endif %}</h2><p>{{ section.settings.description | escape }}</p></div></div>
<div class="clogz-collectiontiles">
{% for block in section.blocks %}<a class="clogz-tile" href="{{ block.settings.link | default: '/collections/clogz-tous-les-sabots' }}" style="--tile-bg:{{ block.settings.color }};--tile-shoe:{{ block.settings.shoe_color }};--clogz-delay:{{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}><span class="clogz-tile__glow" aria-hidden="true"></span><span class="clogz-tile__surface" aria-hidden="true"></span>{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | default: block.settings.label | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% elsif block.settings.image_url != blank %}<img class="clogz-tile__shoe{% if block.settings.image_white_background %} clogz-tile__shoe--whiteback{% endif %}" src="{{ block.settings.image_url | escape }}"{% if block.settings.image_url contains '?' %} srcset="{{ block.settings.image_url | escape }}&amp;width=320 320w, {{ block.settings.image_url | escape }}&amp;width=480 480w, {{ block.settings.image_url | escape }}&amp;width=720 720w, {{ block.settings.image_url | escape }}&amp;width=900 900w"{% endif %} sizes="(max-width: 660px) 46vw, (max-width: 1100px) 31vw, 18vw" alt="Sabot coloris {{ block.settings.label | escape }}" loading="lazy" decoding="async" width="900" height="900">{% else %}<div class="clogz-tile__fallback">{% render 'clog-icon' %}</div>{% endif %}<h3>{{ block.settings.label | escape }} </h3></a>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Collections couleurs","max_blocks":12,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Trouve ta couleur."},{"type":"textarea","id":"description","label":"Description","default":"Du noir intemporel aux pastels. Une paire pour chaque mood."},{"type":"range","id":"zoom_percent","label":"Intensité zoom (%)","min":105,"max":140,"step":1,"default":118,"unit":"%"},{"type":"range","id":"zoom_speed","label":"Durée zoom (secondes)","min":0.3,"max":1,"step":0.1,"unit":"s","default":0.6},{"type":"checkbox","id":"enable_parallax","label":"Parallaxe de la souris","default":true}],"blocks":[{"type":"tile","name":"Couleur / collection","settings":[{"type":"text","id":"label","label":"Nom de la collection","default":"Rose bonbon"},{"type":"color","id":"color","label":"Fond de carte","default":"#F7C9DE"},{"type":"color","id":"shoe_color","label":"Couleur de la silhouette","default":"#FF8FB1"},{"type":"image_picker","id":"image","label":"Image collection"},{"type":"url","id":"link","label":"Destination"},{"type":"text","id":"image_url","label":"URL image du coloris"},{"type":"checkbox","id":"image_white_background","label":"Fond blanc à fondre dans la carte","default":false}]}],"presets":[{"name":"Collections couleurs","blocks":[{"type":"tile","settings":{"label":"Rose bonbon","color":"#EDB9D2","shoe_color":"#FF8FB1"}},{"type":"tile","settings":{"label":"Bleu ciel","color":"#BBE1FC","shoe_color":"#78B9EE"}},{"type":"tile","settings":{"label":"Lilas","color":"#D3C8F8","shoe_color":"#A99BEF"}}]}]}
{% endschema %}
