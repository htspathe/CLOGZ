<section class="clogz-section" id="shop"><div class="clogz-container"><div class="clogz-headrow"><div><p class="clogz-eyebrow" style="color:var(--green)">LE DROP</p><h2 class="clogz-heading">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><a href="/collections/clogz-tous-les-sabots" class="clogz-pill clogz-pill--line">Voir les 10 modèles</a></div>
{% if section.settings.show_clogz_catalog %}
{% render 'clogz-catalog-grid' %}
{% else %}
<div class="clogz-grid">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% else %}<div class="clogz-placeholder">Aucun produit publié dans cette collection.</div>{% endfor %}{% else %}<div class="clogz-placeholder">Notre sélection arrive bientôt. Découvre nos autres sabots en attendant.</div>{% endif %}</div>{% endif %}
</div></section>
{% schema %}
{"name":"Produits vedettes","settings":[{"type":"text","id":"heading","label":"Titre","default":"Les incontournables."},{"type":"textarea","id":"description","label":"Description","default":"Nos modèles disponibles. Choisis ta couleur et ta pointure."},{"type":"checkbox","id":"show_clogz_catalog","label":"Afficher les dix sabots CLOGZ","default":true},{"type":"collection","id":"collection","label":"Collection de produits réels"},{"type":"range","id":"limit","label":"Produits affichés","min":4,"max":12,"step":4,"default":8}],"presets":[{"name":"Produits vedettes"}]}
{% endschema %}
