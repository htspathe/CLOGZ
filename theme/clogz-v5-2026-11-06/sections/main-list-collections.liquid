<style>
.cz4-packs{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:8px}
.cz4-pack{display:flex;flex-direction:column;gap:10px;padding:clamp(22px,3vw,32px);border-radius:24px;background:#fff;border:1px solid #eadfd6;text-decoration:none!important;color:#191817!important;transition:transform .15s ease,box-shadow .15s ease}
.cz4-pack:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(25,24,23,.08)}
.cz4-pack--trio{background:#191817;color:#fff!important;border-color:#191817}
.cz4-pack__tag{align-self:flex-start;font-size:12px;font-weight:800;letter-spacing:.1em;padding:6px 12px;border-radius:999px;background:#ffe9dc;color:#c4402f}
.cz4-pack--trio .cz4-pack__tag{background:#EE4A3D;color:#fff}
.cz4-pack h3{font-family:"Anton",sans-serif;font-weight:800;font-size:clamp(28px,4vw,40px);line-height:1;margin:4px 0 0}
.cz4-pack__price{font-family:"Anton",sans-serif;font-weight:800;font-size:24px}
.cz4-pack__unit{font-size:15px;opacity:.85}
.cz4-pack__cta{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border-radius:999px;background:#EE4A3D;color:#fff;font-family:"Anton",sans-serif;font-weight:800}
</style>
