{% if section.blocks.size > 0 %}
<section class="clogz-section" id="avis"><div class="clogz-container"><div class="clogz-headrow"><div><h2 class="clogz-heading">{{ section.settings.heading | escape }}</h2><p>Des retours réellement reçus de nos clients.</p></div></div><div class="clogz-testimonials">
{% for block in section.blocks %}<blockquote class="clogz-testimonial" {{ block.shopify_attributes }}><div class="clogz-stars" aria-label="{{ block.settings.rating }} étoiles">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</div><p>{{ block.settings.comment | escape }}</p><div class="clogz-testimonial__name">{{ block.settings.customer | escape }}</div></blockquote>{% endfor %}
</div></div></section>{% endif %}
{% schema %}
{"name":"Avis clients vérifiés","settings":[{"type":"text","id":"heading","label":"Titre","default":"Ils les ont adoptés."}],"blocks":[{"type":"review","name":"Avis réel","settings":[{"type":"text","id":"customer","label":"Prénom du client","default":"Client"},{"type":"textarea","id":"comment","label":"Avis reçu","default":"Insérer ici un avis authentique avec autorisation du client."},{"type":"range","id":"rating","label":"Note","min":1,"max":5,"step":1,"default":5}]}],"presets":[{"name":"Avis clients réels"}]}
{% endschema %}