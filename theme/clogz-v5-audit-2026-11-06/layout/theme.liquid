<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <script>document.documentElement.classList.add('clogz-is-loading');window.setTimeout(function(){document.documentElement.classList.remove('clogz-is-loading')},1800);</script>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_ink | escape }}">
  <link rel="canonical" href="{{ canonical_url | escape }}">
  {%- liquid
    assign cz_meta_name = ''
    assign cz_meta_hook = ''
    if request.page_type == 'product' and product.vendor == 'CLOGZ'
      capture cz_meta_name
        render 'clogz-color-name', handle: product.handle, title: product.title
      endcapture
      capture cz_meta_hook
        render 'clogz-color-name', handle: product.handle, title: product.title, field: 'hook'
      endcapture
    endif
  -%}
  {%- capture cz_seo_title_raw -%}
{%- if request.page_type == 'index' -%}
Sabots CLOGZ Dakar · 12 000 FCFA · Livraison gratuite
{%- elsif request.page_type == 'product' and product.vendor == 'CLOGZ' -%}
{{ product.title | replace: 'Sabots CLOGZ - ', '' | replace: 'Crocs ', 'Sabots ' }} · {{ product.price | money_without_currency }} FCFA · CLOGZ
{%- elsif request.page_type == 'list-collections' -%}
Tous les sabots et coloris · CLOGZ Dakar
{%- elsif request.page_type == 'cart' -%}
Ton panier · CLOGZ Dakar
{%- elsif page_title != blank -%}
{{ page_title | replace: shop.name, 'CLOGZ' }} · CLOGZ
{%- else -%}
CLOGZ · Sabots et streetwear à Dakar
{%- endif -%}
{%- endcapture -%}
{%- assign cz_seo_title = cz_seo_title_raw | strip | truncate: 60, '' -%}
<title>{{ cz_seo_title | escape }}</title>
  {% if request.page_type == 'index' %}<meta name="description" content="Crocs à Dakar : 10 couleurs de sabots CLOGZ à 12 000 FCFA, pins offerts. Livraison gratuite partout à Dakar, paiement cash, Wave ou Orange Money.">{% elsif request.page_type == 'product' and product.vendor == 'CLOGZ' and cz_meta_hook != blank %}<meta name="description" content="Crocs {{ cz_meta_name | escape }} à 12 000 FCFA, sabots CLOGZ avec pins offerts. Livraison gratuite à Dakar, paiement à la livraison : cash, Wave ou OM.">{% elsif page_description %}<meta name="description" content="{{ page_description | escape }}">{% elsif request.page_type == 'product' and product.vendor == 'CLOGZ' %}<meta name="description" content="{{ product.title | escape }} chez CLOGZ. Pins offerts. Livraison gratuite à Dakar, paiement à la livraison en cash, Wave ou Orange Money.">{% endif %}
  {% if request.page_type == 'product' and product.vendor != 'CLOGZ' %}<meta name="robots" content="noindex,nofollow">{% elsif request.page_type == 'page' and page.handle contains 'kroza' %}<meta name="robots" content="noindex,nofollow">{% endif %}
  <meta property="og:site_name" content="CLOGZ"><meta property="og:title" content="{{ cz_seo_title | escape }}"><meta property="og:url" content="{{ canonical_url | escape }}"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% else %}<meta property="og:image" content="https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-partage-dakar-street-pop-1200x630.webp?v=1792944533">{% endif %}
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ cz_seo_title | escape }}"><meta name="twitter:description" content="{{ page_description | default: 'CLOGZ : sabots colorés à Dakar, 12 000 FCFA la paire. Pins offerts. Livraison gratuite partout à Dakar, paiement à la livraison en cash, Wave ou Orange Money.' | escape }}">
  <meta name="twitter:image" content="{% if page_image %}https:{{ page_image | image_url: width: 1200 }}{% else %}https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-partage-dakar-street-pop-1200x630.webp?v=1792944533{% endif %}">
  {% if request.page_type == 'index' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"CLOGZ","url":{{ shop.url | json }},"description":"CLOGZ Dakar — sabots colorés et mode streetwear à Dakar."}</script>{% endif %}
  <link rel="icon" type="image/png" sizes="512x512" href="https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-favicon-cz-3d-512-20261028.png?v=1793151468"><link rel="apple-touch-icon" sizes="512x512" href="https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-favicon-cz-3d-512-20261028.png?v=1793151468">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&amp;family=Instrument+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <style>:root{--ink:{{ settings.color_ink }};--green:{{ settings.color_accent }};--cream:{{ settings.color_background }};--pastel:{{ settings.color_pastel }};--clogz-copper:{{ settings.color_copper }};}</style>
  {{ 'clogz.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-loading.css' | asset_url | stylesheet_tag }}
  <script>window.CLOGZ={routes:{cart:'{{ routes.cart_url }}',root:'{{ routes.root_url }}'},currency:{{ shop.currency | json }},moneyFormat:{{ shop.money_format | json }}};</script>
  {{ 'clogz-v2-global.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-performance.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-delivery-gps.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-cart-mobile-v3.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-order-details.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-international-request.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-v4-audit.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-v4-titles.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&display=swap" rel="stylesheet">
  {{ 'clogz-zine.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-zine-sitewide.css' | asset_url | stylesheet_tag }}
  {{ 'clogz-v5-mobile-refresh.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script src="{{ 'clogz-loading.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz.js' | asset_url }}" defer></script>

  <script src="{{ 'clogz-cod-order.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-color-motion.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-mobile-motion.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-v2-global.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-performance.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-delivery-gps.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-order-details.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-international-request.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-checkout-unified.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-zine.js' | asset_url }}" defer></script>
  <script src="{{ 'clogz-v5-carousel.js' | asset_url }}" defer></script>
</head>
<body class="clogz-template-{{ request.page_type | handle }} clogz-v2-unified clogz-zine">
  <div id="ClogzPageLoader" class="clogz-page-loader" role="status" aria-live="polite" aria-label="Chargement de CLOGZ">
    <div class="clogz-page-loader__logo" aria-hidden="true"><span>CZ</span><span class="clogz-page-loader__ring"></span></div>
    <p class="clogz-page-loader__text">CHARGEMENT<span aria-hidden="true">...</span></p>
    <button type="button" class="clogz-page-loader__skip" data-clogz-skip-loader aria-label="Passer l'animation de chargement">PASSER</button>
  </div>
  <a class="skip-link" href="#MainContent">Aller au contenu</a>
  {% section 'site-header' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% section 'site-footer' %}
  {% section 'cart-drawer' %}

  <div class="clogz-toast" id="ClogzToast" role="status" aria-live="polite"></div>
</body>
</html>
