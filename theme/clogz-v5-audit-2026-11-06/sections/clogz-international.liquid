<style>
.cz4-intl{padding:clamp(40px,6vw,80px) 0}
.cz4-intl__card{display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;background:#fff;border:1px solid #eadfd6;border-radius:24px;padding:clamp(24px,4vw,44px)}
.cz4-intl__text{flex:1 1 420px;max-width:680px}
.cz4-intl__eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800;letter-spacing:.12em;color:#c4402f;text-transform:uppercase;margin:0 0 10px}
.cz4-intl__eyebrow svg{width:18px;height:18px;flex:none}
.cz4-intl h2{font-family:"Bricolage Grotesque","Instrument Sans",sans-serif;font-weight:800;font-size:clamp(26px,3.6vw,42px);line-height:1.05;color:#191817;margin:0 0 12px}
.cz4-intl p.cz4-intl__copy{margin:0;color:#32302e;font-size:16px;line-height:1.55}
.cz4-intl__button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 28px;border-radius:999px;background:#EE4A3D;color:#fff;font-family:"Bricolage Grotesque","Instrument Sans",sans-serif;font-weight:800;text-decoration:none;white-space:nowrap}
.cz4-intl__button:hover{background:#d63b2f}
@media(max-width:700px){.cz4-intl__button{width:100%}}
</style>
<section class="cz4-intl" id="clogz-sans-frontieres" aria-labelledby="ClogzIntlTitle-{{ section.id }}">
  <div class="clogz-container">
    <div class="cz4-intl__card">
      <div class="cz4-intl__text">
        <p class="cz4-intl__eyebrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>{{ section.settings.eyebrow | escape }}</p>
        <h2 id="ClogzIntlTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="cz4-intl__copy">{{ section.settings.text | escape }}</p>
      </div>
      <a class="cz4-intl__button" href="{{ section.settings.link | default: '/pages/commandes-internationales' }}">{{ section.settings.button | escape }}</a>
    </div>
  </div>
</section>
{% schema %}
{"name":"CLOGZ sans frontières","settings":[{"type":"text","id":"eyebrow","label":"Sur-titre","default":"CLOGZ SANS FRONTIÈRES"},{"type":"text","id":"heading","label":"Titre","default":"Tu es loin ? Offre une paire à Dakar."},{"type":"textarea","id":"text","label":"Texte","default":"Commande d’où tu veux. On livre ton proche à Dakar, gratuitement. Il paie à la réception : cash, Wave ou OM."},{"type":"text","id":"button","label":"Texte du bouton","default":"Offrir une paire"},{"type":"url","id":"link","label":"Lien du bouton"}],"presets":[{"name":"CLOGZ sans frontières"}]}
{% endschema %}
