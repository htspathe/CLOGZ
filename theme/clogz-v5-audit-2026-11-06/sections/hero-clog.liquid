<section class="clogz-hero" id="ClogzHero-{{ section.id }}">
 {% if section.settings.float_shapes %}<div aria-hidden="true">
 {% for i in (1..10) %}<div class="clogz-hero__float" style="--float-x:{{ i | times: 9 | modulo: 92 }}%;--float-y:{{ i | times: 29 | modulo: 83 }}%;--float-size:{{ i | modulo: 3 | times: 39 | plus: 85 }}px;--float-speed:{{ i | modulo: 4 | plus: 7 }}s;--float-color:{% cycle '#c7a3f5','#8dbcf8','#FFD5C5','#f7a4bc' %}">{% render 'clog-icon' %}</div>{% endfor %}
 </div>{% endif %}
 <div class="clogz-container clogz-hero__inner">
  <div class="clogz-hero__copy"><span class="clogz-eyebrow" style="color:#8C3A2C">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.title_top | escape }}<br><span>{{ section.settings.title_bottom | escape }}</span></h1><p>{{ section.settings.subtitle | escape }}</p><div class="clogz-offer-chips" aria-label="Offres CLOGZ"><span>12 000 FCFA</span><span>Livraison offerte à Dakar après confirmation de ta commande.</span><span>Pins offerts</span><span>💵 Paiement à la livraison</span></div><div class="clogz-hero__ctas"><a class="clogz-pill clogz-pill--light" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }} </a>{% if section.settings.secondary_label != blank %}<a class="clogz-pill" style="background:#ffffff12;border-color:#ffffff50" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}</div></div>
  <div class="clogz-hero__stage" data-hero-stage><div class="clogz-hero__glow"></div>
   {% if section.settings.image != blank %}<img class="clogz-hero__photo" src="{{ section.settings.image | image_url: width: 1200 }}" srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w" sizes="(max-width: 850px) 90vw, 45vw" alt="{{ section.settings.image.alt | default: 'Sabot tendance CLOGZ' | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" fetchpriority="high">
   {% elsif section.settings.image_url != blank %}<img class="clogz-hero__photo" src="{{ section.settings.image_url | escape }}" alt="Collection de sabots pastel CLOGZ" width="1024" height="1024" fetchpriority="high" style="mix-blend-mode:multiply">{% else %}<div class="clogz-hero__shoe" data-hero-shoe>{% render 'clog-icon' %}</div><div class="clogz-hero__swatches" aria-label="Changer la couleur de l’illustration"><button class="clogz-swatch" style="--swatch:#ff88ad" data-hero-color="#ff88ad" aria-label="Rose" aria-pressed="true"></button><button class="clogz-swatch" style="--swatch:#87bbed" data-hero-color="#87bbed" aria-label="Bleu" aria-pressed="false"></button><button class="clogz-swatch" style="--swatch:#bbadf4" data-hero-color="#bbadf4" aria-label="Lilas" aria-pressed="false"></button><button class="clogz-swatch" style="--swatch:#e84850" data-hero-color="#e84850" aria-label="Rouge" aria-pressed="false"></button><button class="clogz-swatch" style="--swatch:#3e4044" data-hero-color="#3e4044" aria-label="Noir" aria-pressed="false"></button></div>{% endif %}
  </div>
 </div>
</section>
{% schema %}
{"name":"Hero animé CLOGZ","settings":[{"type":"text","id":"eyebrow","label":"Sur-titre","default":"DAKAR • READY TO WEAR"},{"type":"text","id":"title_top","label":"Titre première ligne","default":"Marche"},{"type":"text","id":"title_bottom","label":"Titre seconde ligne","default":"différemment."},{"type":"textarea","id":"subtitle","label":"Sous-titre","default":"La paire à 12 000 FCFA, les pins offerts et la livraison offerte à Dakar après confirmation de ta commande. Choisis ton style et ta pointure du 36 au 46."},{"type":"image_picker","id":"image","label":"Photo du hero (remplace la silhouette vectorielle)"},{"type":"text","id":"image_url","label":"Image de présentation provisoire","default":"https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-collection-pastel.webp?v=1792776064"},{"type":"checkbox","id":"float_shapes","label":"Activer les chaussures flottantes","default":true},{"type":"text","id":"primary_label","label":"Bouton principal","default":"Découvrir la collection"},{"type":"url","id":"primary_link","label":"Lien bouton principal"},{"type":"text","id":"secondary_label","label":"Bouton secondaire","default":"Explorer les collections"},{"type":"url","id":"secondary_link","label":"Lien bouton secondaire"}],"presets":[{"name":"Hero animé CLOGZ"}]}
{% endschema %}
