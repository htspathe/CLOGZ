<section class="clogz-section" id="jibbitz"><div class="clogz-container"><div class="clogz-feature"><div><p class="clogz-eyebrow" style="color:var(--green)">SOIS UNIQUE</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="clogz-pill clogz-pill--green" href="{{ section.settings.link | default: '/pages/idees-de-personnalisation' }}">{{ section.settings.button_label | escape }}</a></div>
<div class="clogz-charm-gallery" aria-label="Exemples de pins décoratifs offerts">
 <div class="clogz-charm-gallery__main">{% if section.settings.feature_image != blank %}<img src="{{ section.settings.feature_image | image_url: width: 950 }}" width="{{ section.settings.feature_image.width }}" height="{{ section.settings.feature_image.height }}" alt="{{ section.settings.feature_image.alt | default: 'Sabots personnalisés avec pins' | escape }}" loading="lazy">{% else %}<img src="https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-pins-roses-detail.jpg?v=1792776760" width="800" height="800" alt="Pins décoratifs sur sabots roses" loading="lazy">{% endif %}</div>
 <div class="clogz-charm-gallery__overlay"><img src="https://cdn.shopify.com/s/files/1/0783/6398/3932/files/clogz-pins-assortiment.jpg?v=1792776765" width="240" height="240" alt="Idées de pins décoratifs colorés" loading="lazy"></div>
</div>
</div></div></section>
{% schema %}
{"name":"Mise en avant charms","settings":[{"type":"text","id":"heading","label":"Titre","default":"Fais-les à ton image."},{"type":"textarea","id":"description","label":"Description","default":"Des pins décoratifs offerts avec chaque paire. Personnalise tes sabots sans supplément — illustrations des styles possibles."},{"type":"text","id":"button_label","label":"Texte bouton","default":"Découvrir les sabots"},{"type":"url","id":"link","label":"Lien"},{"type":"image_picker","id":"feature_image","label":"Photo des pins offerts"}],"presets":[{"name":"Mise en avant charms"}]}
{% endschema %}
