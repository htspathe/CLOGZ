<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title %}{{ page_title | escape }}{% else %}{{ shop.name | escape }}{% endif %}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name | escape }}"><meta property="og:title" content="{{ page_title | default: shop.name | escape }}"><meta property="og:url" content="{{ canonical_url }}"><meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">{% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{% else %}<link rel="icon" type="image/svg+xml" href="{{ 'clogz-favicon.svg' | asset_url }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  {{ 'clogz.css' | asset_url | stylesheet_tag }}
  <style>:root{--ink:{{ settings.color_ink }};--green:{{ settings.color_accent }};--cream:{{ settings.color_background }};--pastel:{{ settings.color_pastel }};}</style>
  <script>window.CLOGZ={routes:{cart:'{{ routes.cart_url }}',root:'{{ routes.root_url }}'},currency:{{ shop.currency | json }},moneyFormat:{{ shop.money_format | json }}};</script>
  {{ content_for_header }}
  <script src="{{ 'clogz.js' | asset_url }}" defer></script>
</head>
<body class="clogz-template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#MainContent">Aller au contenu</a>
  {% section 'announcement-bar' %}
  {% section 'site-header' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% section 'site-footer' %}
  {% section 'cart-drawer' %}
  <div class="clogz-toast" id="ClogzToast" role="status" aria-live="polite"></div>
</body>
</html>
