<section class="clogz-section"><div class="clogz-container"><div class="clogz-benefits">{% for block in section.blocks %}<div class="clogz-benefit" {{ block.shopify_attributes }}><div class="clogz-benefit__symbol" aria-hidden="true">{{ block.settings.emoji }}</div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p></div>{% endfor %}</div></div></section>
{% schema %}
{"name":"Avantages CLOGZ","max_blocks":6,"settings":[],"blocks":[{"type":"benefit","name":"Avantage","settings":[{"type":"text","id":"emoji","label":"Icône emoji","default":"✨"},{"type":"text","id":"title","label":"Titre","default":"Ton style"},{"type":"textarea","id":"description","label":"Description","default":"Découvre nos modèles et couleurs."}]}],"presets":[{"name":"Avantages CLOGZ","blocks":[{"type":"benefit","settings":{"emoji":"🪶","title":"Légers","description":"Des sabots conçus pour un port agréable au quotidien."}},{"type":"benefit","settings":{"emoji":"🎨","title":"Ton style","description":"Couleurs et accessoires selon les modèles disponibles."}},{"type":"benefit","settings":{"emoji":"📍","title":"Stock à Dakar","description":"Produits physiquement disponibles et quantités actualisées."}},{"type":"benefit","settings":{"emoji":"📦","title":"Livraison locale","description":"Options et frais précisés lors de la commande."}}]}]}
{% endschema %}
