<div class="clogz-drawer__overlay" id="ClogzOverlay" hidden></div>
<aside class="clogz-drawer" id="ClogzDrawer" aria-label="Votre panier" aria-hidden="true" hidden>
 <div class="clogz-drawer__head"><h2>Mon panier</h2><button id="ClogzCloseCart" type="button" class="clogz-iconbutton" aria-label="Fermer le panier">✕</button></div>
 <div class="clogz-drawer__items" id="ClogzCartItems"></div>
 <div class="clogz-drawer__bottom">
  <div class="clogz-drawer__shipping" {% if section.settings.free_shipping_threshold == 0 %}hidden{% endif %}><div class="clogz-drawer__progress"><span id="ClogzShippingProgress" data-threshold="{{ section.settings.free_shipping_threshold | times: 100 }}"></span></div><div class="clogz-drawer__delivery" id="ClogzShippingMessage"></div></div>
  <div class="clogz-drawer__total"><span>Sous-total</span><span id="ClogzCartTotal">{{ cart.total_price | money }}</span></div>
  <small class="clogz-muted">Frais et options de livraison calculés à la commande.</small>
  <div class="clogz-drawer__buttons"><a href="{{ routes.cart_url }}" class="clogz-pill clogz-pill--line">Voir le panier</a><a href="{{ routes.root_url }}checkout" class="clogz-pill clogz-pill--green">Commander</a></div>
 </div>
</aside>
{% schema %}
{"name":"Panier latéral","settings":[{"type":"number","id":"free_shipping_threshold","label":"Seuil livraison offerte (unités de devise; 0 pour désactiver)","default":0,"info":"À utiliser uniquement si la règle est configurée dans vos tarifs de livraison Shopify."}]}
{% endschema %}
