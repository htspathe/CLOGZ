<section class="clogz-section" id="collections-{{ section.id }}"><div class="clogz-container"><div class="clogz-headrow"><div><p class="clogz-eyebrow" style="color:var(--green)">CHOISIS TON MOOD</p><h2 class="clogz-heading">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div></div>
<div class="clogz-collectiontiles">
{% for block in section.blocks %}<a class="clogz-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" style="--tile-bg:{{ block.settings.color }};--tile-shoe:{{ block.settings.shoe_color }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | default: block.settings.label | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="clogz-tile__fallback">{% render 'clog-icon' %}</div>{% endif %}<h3>{{ block.settings.label | escape }} ↗</h3></a>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Collections couleurs","max_blocks":9,"settings":[{"type":"text","id":"heading","label":"Titre","default":"Trouve ta couleur."},{"type":"textarea","id":"description","label":"Description","default":"Du noir intemporel aux pastels. Une paire pour chaque mood."}],"blocks":[{"type":"tile","name":"Couleur / collection","settings":[{"type":"text","id":"label","label":"Nom de la collection","default":"Rose bonbon"},{"type":"color","id":"color","label":"Fond de carte","default":"#F7C9DE"},{"type":"color","id":"shoe_color","label":"Couleur de la silhouette","default":"#FF8FB1"},{"type":"image_picker","id":"image","label":"Image collection"},{"type":"url","id":"link","label":"Destination"}]}],"presets":[{"name":"Collections couleurs","blocks":[{"type":"tile","settings":{"label":"Rose bonbon","color":"#EDB9D2","shoe_color":"#FF8FB1"}},{"type":"tile","settings":{"label":"Bleu ciel","color":"#BBE1FC","shoe_color":"#78B9EE"}},{"type":"tile","settings":{"label":"Lilas","color":"#D3C8F8","shoe_color":"#A99BEF"}}]}]}
{% endschema %}
