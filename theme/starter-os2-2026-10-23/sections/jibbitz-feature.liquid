<section class="clogz-section" id="jibbitz"><div class="clogz-container"><div class="clogz-feature"><div><p class="clogz-eyebrow" style="color:var(--green)">SOIS UNIQUE</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p><a class="clogz-pill clogz-pill--green" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} ↗</a></div>
<div class="clogz-charms" aria-hidden="true"><div class="clogz-charm" style="--charm-bg:#ffdfeb;--float-speed:7s">⭐</div><div class="clogz-charm" style="--charm-bg:#e0efff;--float-speed:8s">🌈</div><div class="clogz-charm" style="--charm-bg:#e7ddff;--float-speed:6s">💜</div><div class="clogz-charm" style="--charm-bg:#e2f6e5;--float-speed:9s">🍀</div><div class="clogz-charm" style="--charm-bg:#fff4c8;--float-speed:7s">⚡</div><div class="clogz-charm" style="--charm-bg:#ffdce9;--float-speed:8s">💖</div></div>
</div></div></section>
{% schema %}
{"name":"Mise en avant charms","settings":[{"type":"text","id":"heading","label":"Titre","default":"Fais-les à ton image."},{"type":"textarea","id":"description","label":"Description","default":"Des charms pour personnaliser chaque paire. Découvre les modèles disponibles dans notre stock."},{"type":"text","id":"button_label","label":"Texte bouton","default":"Découvrir les charms"},{"type":"url","id":"link","label":"Lien"}],"presets":[{"name":"Mise en avant charms"}]}
{% endschema %}
