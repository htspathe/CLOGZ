<section class="clogz-page-space"><div class="clogz-container"><h1 class="clogz-page-title">Mon panier</h1>
{% if cart.item_count == 0 %}<p>Ton panier est vide.</p><a class="clogz-pill" href="{{ routes.all_products_collection_url }}">Découvrir la collection</a>{% else %}
<form action="{{ routes.cart_url }}" method="post"><table class="clogz-cart-table"><thead><tr><th>Article</th><th>Prix</th><th>Qté</th><th>Total</th></tr></thead><tbody>{% for item in cart.items %}<tr>
<td><a href="{{ item.url }}">{% if item.image %}<img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.product.title | escape }}" loading="lazy" width="110" height="110">{% endif %}<div>{{ item.product.title | escape }}</div><small class="clogz-muted">{% unless item.variant.title == 'Default Title' %}{{ item.variant.title | escape }}{% endunless %}</small></a><a href="{{ item.url_to_remove }}" class="clogz-muted" style="display:block;text-decoration:underline">Retirer</a></td>
<td>{{ item.final_price | money }}</td><td><label class="clogz-sr-only" for="CartQuantity-{{ forloop.index }}">Quantité {{ item.product.title | escape }}</label><input class="clogz-cart-qty" id="CartQuantity-{{ forloop.index }}" type="number" min="0" name="updates[]" value="{{ item.quantity }}"></td><td>{{ item.final_line_price | money }}</td>
</tr>{% endfor %}</tbody></table><div class="clogz-cart-total"><strong>Sous-total : {{ cart.total_price | money }}</strong><p class="clogz-muted">Livraison calculée à la prochaine étape.</p></div><div class="clogz-cart-actions"><button name="update" class="clogz-pill clogz-pill--line" type="submit">Actualiser le panier</button><button name="checkout" class="clogz-pill clogz-pill--green" type="submit">Passer commande →</button></div></form>
{% endif %}</div></section>
{% schema %}{"name":"Page panier","settings":[]}{% endschema %}
