<section class="clogz-page-space"><div class="clogz-container"><div class="clogz-breadcrumb"><a href="{{ routes.root_url }}">Accueil</a> / Collections</div><div class="clogz-collection-intro"><h1 class="clogz-page-title">{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="clogz-product__description">{{ collection.description }}</div>{% endif %}</div>
{% paginate collection.products by 24 %}<div class="clogz-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="clogz-placeholder">Aucun produit dans cette collection pour le moment.</div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="clogz-pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Précédent</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Suivant →</a>{% endif %}</nav>{% endif %}{% endpaginate %}
</div></section>
{% schema %}{"name":"Catalogue collection","settings":[]}{% endschema %}
