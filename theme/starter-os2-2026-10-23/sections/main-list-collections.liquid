<section class="clogz-page-space"><div class="clogz-container"><h1 class="clogz-page-title">Toutes les collections</h1><div class="clogz-collectiontiles">{% for collection in collections %}{% unless collection.handle == 'frontpage' %}<a class="clogz-tile" style="--tile-bg:#c6e9d0" href="{{ collection.url }}">{% if collection.featured_image != blank %}<img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">{% else %}<div class="clogz-tile__fallback">{% render 'clog-icon' %}</div>{% endif %}<h3>{{ collection.title | escape }} ↗</h3></a>{% endunless %}{% else %}<div class="clogz-placeholder">Crée ta première collection Shopify.</div>{% endfor %}</div></div></section>
{% schema %}{"name":"Liste des collections","settings":[]}{% endschema %}
