<section class="clogz-page-space"><div class="clogz-container"><h1 class="clogz-page-title">Recherche</h1><form action="{{ routes.search_url }}" method="get" role="search" style="margin-bottom:35px;display:flex;gap:10px;max-width:600px"><label class="clogz-sr-only" for="ClogzSearch">Rechercher un produit</label><input id="ClogzSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Couleur, modèle, taille..." style="width:100%"><input type="hidden" name="type" value="product"><button class="clogz-pill" type="submit">Chercher</button></form>
{% if search.performed %}<p>{{ search.results_count }} résultat(s) pour « {{ search.terms | escape }} »</p>{% paginate search.results by 24 %}<div class="clogz-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<div class="clogz-placeholder">Aucun résultat. Essaie une autre recherche.</div>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="clogz-pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Précédent</a>{% endif %}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Suivant →</a>{% endif %}</nav>{% endif %}{% endpaginate %}{% endif %}
</div></section>
{% schema %}{"name":"Recherche produits","settings":[]}{% endschema %}
