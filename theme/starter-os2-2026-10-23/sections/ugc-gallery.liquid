{% if section.blocks.size > 0 %}<section class="clogz-section"><div class="clogz-container"><div class="clogz-headrow"><div><p class="clogz-eyebrow" style="color:var(--green)">@CLOGZ</p><h2 class="clogz-heading">{{ section.settings.heading | escape }}</h2></div></div><div class="clogz-ugc">{% for block in section.blocks %}{% if block.settings.image != blank %}{% if block.settings.url != blank %}<a href="{{ block.settings.url }}" rel="noopener noreferrer" target="_blank">{% endif %}<img src="{{ block.settings.image | image_url: width: 650 }}" alt="{{ block.settings.image.alt | default: 'Photo de la communauté' | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% if block.settings.url != blank %}</a>{% endif %}{% endif %}{% endfor %}</div></div></section>{% endif %}
{% schema %}
{"name":"Photos communauté","settings":[{"type":"text","id":"heading","label":"Titre","default":"Vu dans la rue."}],"blocks":[{"type":"photo","name":"Photo autorisée","settings":[{"type":"image_picker","id":"image","label":"Photo avec droit de publication"},{"type":"url","id":"url","label":"Lien Instagram ou TikTok"}]}],"presets":[{"name":"Photos communauté"}]}
{% endschema %}
